import random

# Character class with abilities and progression
class Character:
    def __init__(self, name, element, ability_description, special_ability, cooldown, upgrades):
        self.name = name
        self.element = element
        self.ability_description = ability_description
        self.special_ability = special_ability
        self.cooldown = cooldown
        self.upgrades = upgrades

    def use_ability(self):
        if self.cooldown == 0:
            self.cooldown = 3  # Reset cooldown
            return f"{self.name} uses their ability: {self.special_ability}!"
        else:
            self.cooldown -= 1
            return f"{self.name}'s ability is on cooldown for {self.cooldown} turns."

    def upgrade_ability(self):
        if self.upgrades > 0:
            self.upgrades -= 1
            return f"{self.name} upgrades their ability, gaining new strength!"
        else:
            return f"{self.name} has no upgrades available."

# Define characters
helior = Character("Helior", "Light",
                   "Master of radiance, illuminating paths and blinding enemies.",
                   "Radiant Flare - Reveals hidden objects and blinds foes!", 0, 2)
kael = Character("Kael", "Shadows",
                 "Wielder of shadows, confusing foes and vanishing into darkness.",
                 "Phantom Veil - Turns invisible to avoid detection.", 0, 2)
pyros = Character("Pyros", "Flames",
                  "Unleashes uncontrolled bursts of fire to clear enemies.",
                  "Infernal Fury - A fiery explosion that burns everything!", 0, 2)
mystiko = Character("Mystiko", "Illusions",
                    "Creates lifelike illusions to trick enemies and confuse their senses.",
                    "Holographic Mirage - Confuses enemies with illusions!", 0, 2)
lady_onyx = Character("Lady Onyx", "Gravity",
                      "Controls gravitational force to crush foes or defy physics.",
                      "Gravity Well - A vortex that traps and damages enemies!", 0, 2)

# Game loop for exploration, combat, and upgrades
def game_loop():
    characters = [helior, kael, pyros, mystiko, lady_onyx]
    print("Welcome to Ninjago Chronicles - The War of Elements!")
    print("Choose your character:")
    
    for index, character in enumerate(characters, start=1):
        print(f"{index}. {character.name} - {character.element}")

    choice = int(input("Enter the number of your choice: ")) - 1
    player = characters[choice]

    print(f"You chose {player.name}, the Master of {player.element}!")
    print(player.ability_description)
    
    for turn in range(5):  # Example gameplay loop
        print("\nWhat would you like to do?")
        print("1. Use Ability")
        print("2. Upgrade Ability")
        print("3. Encounter Enemies")
        print("4. Solve Puzzle")
        action = int(input("Enter your choice: "))
        
        if action == 1:
            print(player.use_ability())
        elif action == 2:
            print(player.upgrade_ability())
        elif action == 3:
            encounter_enemies(player)
        elif action == 4:
            solve_puzzle(player)
        else:
            print("Invalid choice.")

def encounter_enemies(character):
    enemy = random.choice(["Shadow Wraith", "Flame Beast", "Gravity Specter"])
    print(f"A wild {enemy} appears!")
    print(character.use_ability())

def solve_puzzle(character):
    print(f"{character.name} uses their element to solve a complex puzzle!")
    print(character.use_ability())

game_loop()
